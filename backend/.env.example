# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# live | testnet  — MODE=sim does not exist
MODE=testnet

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://xcapital:xcapital_secret@localhost:5432/xcapital_db"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_very_long_random_secret_minimum_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_EMAILS=admin@xcapital.io

GOOGLE_CLIENT_ID=

FRONTEND_URL=http://localhost:3000

# ─── Market data (never a mock source of truth) ─────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# MODE=live must use https://api.alpaca.markets (not paper-api)
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ─── Custody — Tatum (xpub / virtual account ids ONLY — no private keys) ────
TATUM_API_KEY=
TATUM_API_URL=https://api.tatum.io
TATUM_XPUB_BTC=
TATUM_XPUB_ETH=
TATUM_XPUB_TRON=
TATUM_XPUB_SOL=
TATUM_BTC_ACCOUNT_ID=
TATUM_ETH_ACCOUNT_ID=
TATUM_USDT_ACCOUNT_ID=
TATUM_SOL_ACCOUNT_ID=
TATUM_WEBHOOK_SECRET=
TATUM_JSON_RPC=

VAULT_BTC=
VAULT_ETH=
VAULT_BNB=
VAULT_USDT_ETH=
VAULT_DOGE=
VAULT_TRX=

ETHEREUM_RPC_URL=

AI_ORACLE_URL=http://localhost:8000
KYC_PROVIDER=persona
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
